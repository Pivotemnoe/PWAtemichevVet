[Unit]
Description=TemichevVet PWA follow-up push sender
After=network-online.target temichevvet_pwa.service
Wants=network-online.target

[Service]
Type=oneshot
User=temichevvet
Group=temichevvet
WorkingDirectory=/opt/temichevvet/pwa
ExecStart=/opt/temichevvet/scripts/send_pwa_followups.sh
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/temichevvet/data
