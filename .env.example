APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8080
SESSION_SECRET=change-me-long-random-secret
DATABASE_PATH=./pwa.db

# Optional: existing Telegram/Max auth entry points.
TELEGRAM_BOT_USERNAME=
# Shared server-to-server secret. The Telegram bot must use the same value as PWA_TELEGRAM_AUTH_SECRET.
TELEGRAM_AUTH_SECRET=
MAX_BOT_USERNAME=
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api.max.ru
MAX_WEBHOOK_SECRET=

# Development only: returns auth code in API response.
DEV_AUTH_CODE_LOG=1

# Optional SMTP for production email codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=1

# Optional future integration with the Telegram bot database.
BOT_DATABASE_PATH=

# Closed internal API secret for the NL Telegram bot -> RU storage bridge.
# Must match CORE_API_TOKEN in the Telegram bot .env.
CORE_API_SECRET=

# Closed operational APIs. Do not expose these values in the frontend.
ADMIN_API_SECRET=
# Password hash for browser admin panel. Generate with app.security.make_password_hash().
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
MONITORING_API_SECRET=

# YooKassa Plus payments. Secrets stay server-side only.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://127.0.0.1:8080/?payment=plus
# Optional: use this as query token in the YooKassa webhook URL.
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_RECEIPT_EMAIL=
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_VAT_CODE=1

# Server-side LLM triage. Never expose this key to the browser.
OPENAI_API_KEY=
# Optional OpenAI-compatible gateway URL. In production RU PWA uses a local SSH tunnel to the NL gateway.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FREE=gpt-4o-mini
OPENAI_MODEL_PLUS=gpt-5-mini
OPENAI_MODEL_PRO=gpt-5-mini
OPENAI_MODEL_VIP=gpt-5

# Optional PWA push notifications. Generate a VAPID key pair before enabling.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@temichevvet.ru
